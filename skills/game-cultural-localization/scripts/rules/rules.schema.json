{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "lqa_linter rule file",
  "type": "object",
  "required": [
    "locale",
    "rules"
  ],
  "properties": {
    "locale": {
      "type": "string",
      "description": "Canonical locale this file applies to (en, tr-TR, de-DE, fr, es-ES, it-IT, pt-BR, pt-PT, pl-PL, lt-LT, ru-RU, ja-JP, ko-KR, zh-CN, zh-Hant)"
    },
    "version": {
      "type": "integer"
    },
    "notes": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "pattern",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique rule id, e.g. DE-EHE"
          },
          "severity": {
            "enum": [
              "ERR",
              "WARN"
            ]
          },
          "pattern": {
            "type": "string",
            "description": "Python 're' regular expression searched in the TARGET string"
          },
          "flags": {
            "type": "string",
            "description": "Any of i (IGNORECASE), m (MULTILINE), x (VERBOSE)"
          },
          "message": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "description": "Why the rule exists or how it was narrowed, for maintainers. The linter ignores it and never prints it"
          },
          "context": {
            "enum": [
              "any",
              "ui",
              "dialog",
              "player",
              "button",
              "formal"
            ],
            "description": "any (default); ui/dialog apply unless the row is tagged with the other context; player/button/formal apply only to rows tagged player (meta player:true / tags contain 'player'), button (category button or key containing BTN/BUTTON) or formal (category dialogue_formal, formal, official, news, announcement, press, lore, codex, encyclopedia, or a key segment Codex/Lore/News)"
          },
          "skip_contexts": {
            "type": "array",
            "items": {
              "enum": [
                "ui",
                "dialog",
                "player",
                "button",
                "formal"
              ]
            },
            "description": "Row contexts where the rule never applies, e.g. [\"formal\"] keeps report style allowed in formal text, news and codex lore"
          },
          "skip_variants": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Regional variants (--variant) for which the rule is skipped, e.g. [\"hk\"]"
          },
          "examples": {
            "type": "object",
            "properties": {
              "match": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "nomatch": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "variant_severity": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "ERR",
                "WARN"
              ]
            },
            "description": "Severity override per --variant, e.g. {\"hk\": \"WARN\"}"
          }
        }
      }
    }
  }
}
